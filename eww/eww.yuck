(defpoll time-zone
  :initial "America/Toronto"
  :interval "1m"
  :run-while false
  `timedatectl -p Timezone show | cut -d = -f 2`)

(defpoll battery-capacity
  :interval "1s"
  `cat /sys/class/power_supply/*/capacity | head -n 1`)

(defpoll battery-status
  :interval "1s"
  `cat /sys/class/power_supply/*/status | head -n 1`)

(defpoll idle-inhibited
  :initial false
  :interval "1s"
  `systemctl --user is-active --quiet eww-idle-inhibit.service && echo true || echo false`)

(deflisten volume-level "sh ~/.config/eww/scripts/volume.sh")
(deflisten workspace-list "bun ~/.config/eww/scripts/workspaces.ts")

(defwindow status-0
  :monitor 0
  :geometry
    (geometry
      :width "100%"
      :anchor "top center")
  :exclusive true
  (status
    :monitor 0))

(defwindow status-1
  :monitor 1
  :geometry
    (geometry
      :width "100%"
      :anchor "top center")
  :exclusive true
  (status
    :monitor 1))

(defwindow status-2
  :monitor 2
  :geometry
    (geometry
      :width "100%"
      :anchor "top center")
  :exclusive true
  (status
    :monitor 2))

(defwidget status [monitor]
  (box
    :class "status"
    :orientation "horizontal"
    :space-evenly false
    (workspaces
      :monitor monitor)
    (title
      :monitor monitor)
    (box
      :halign "end"
      :space-evenly false
      (idle-inhibit)
      (volume)
      (battery)
      (clock))))

(defwidget workspaces [monitor]
  (box
    :halign "start"
    :space-evenly true
    (for item in "${jq(workspace-list, ".workspaces")}"
      (workspace
        :monitor monitor
        :item item))))

(defwidget workspace [monitor item]
  (button
    :class
      {item.monitor == monitor ?
        (item.active ? "workspace-active" : "workspace-inactive") :
        (item.monitor != "null" ?
          (item.active ? "workspace-active-other" : "workspace-inactive-other") :
          "workspace-empty")}
    :valign "center"
    :width 30
    :height 30
    :onclick "hyprctl --batch 'dispatch hl.dsp.workspace.move({ workspace = ${item.id}, monitor = \"current\" }); dispatch hl.dsp.focus({ workspace = ${item.id} })'"
    {item.id}))

(defwidget title [monitor]
  (label
    :class "title"
    :halign "fill"
    :hexpand true
    :xalign 0
    :justify "left"
    :truncate true
    :show-truncated true
    :text "${replace("${jq(workspace-list, ".workspaces[${jq(workspace-list, ".monitors[${monitor}]")-1}].lastwindowtitle")}", "^\"|\"$", "")}"))

(defwidget idle-inhibit []
  (button
    :class {idle-inhibited ? "idle-inhibit active" : "idle-inhibit"}
    :valign "center"
    :tooltip {idle-inhibited ? "Automatic lock and screen-off inhibited (click to restore)" : "Inhibit automatic lock and screen-off"}
    :onclick "if systemctl --user is-active --quiet eww-idle-inhibit.service; then systemctl --user stop eww-idle-inhibit.service; else systemctl --user start eww-idle-inhibit.service; fi"
    (image
      :icon {idle-inhibited ? "changes-allow-symbolic" : "changes-prevent-symbolic"}
      :icon-size "button")))

(defwidget volume []
  (box
    :space-evenly false
    (eventbox
      :onscroll "echo {} | sed -e 's/down/-10%/' -e 's/up/+10%/' | xargs pactl set-sink-volume @DEFAULT_SINK@"
      (button
        :class "sink-volume ${jq(volume-level, ".sink.muted") ? "muted" :
          jq(volume-level, ".sink.volume") >= 90 ? "critical" :
          jq(volume-level, ".sink.volume") >= 70 ? "high" : "normal"}"
        :halign "end"
        :onclick "pactl set-sink-mute @DEFAULT_SINK@ toggle && pactl set-sink-volume @DEFAULT_SINK@ 30%"
        (box
          :space-evenly false
          :spacing 4
          (image
            :icon {jq(volume-level, ".sink.muted") ? "audio-volume-muted-symbolic" :
              jq(volume-level, ".sink.volume") <= 10 ? "audio-volume-low-symbolic" :
              jq(volume-level, ".sink.volume") <= 50 ? "audio-volume-medium-symbolic" :
                                                       "audio-volume-high-symbolic"}
            :icon-size "button")
          (label
            :text "${jq(volume-level, ".sink.volume")}%"))))
    (eventbox
      :onscroll "echo {} | sed -e 's/down/-10%/' -e 's/up/+10%/' | xargs pactl set-source-volume @DEFAULT_SOURCE@"
      (button
        :class "source-volume ${jq(volume-level, ".source.muted") ? "muted" :
          jq(volume-level, ".source.volume") >= 90 ? "critical" :
          jq(volume-level, ".source.volume") >= 70 ? "high" : "normal"}"
        :halign "end"
        :onclick "pactl set-source-mute @DEFAULT_SOURCE@ toggle && pactl set-source-volume @DEFAULT_SOURCE@ 60%"
        (box
          :space-evenly false
          :spacing 4
          (image
            :icon {jq(volume-level, ".source.muted") ? "microphone-sensitivity-muted-symbolic" :
              jq(volume-level, ".source.volume") <= 10 ? "microphone-sensitivity-low-symbolic" :
              jq(volume-level, ".source.volume") <= 50 ? "microphone-sensitivity-medium-symbolic" :
                                                         "microphone-sensitivity-high-symbolic"}
            :icon-size "button")
          (label
            :text "${jq(volume-level, ".source.volume")}%"))))))

(defwidget battery []
  (box
    :class "battery ${battery-capacity <= 10 ? "critical" :
      battery-capacity <= 30 ? "low" :
      battery-capacity <= 50 ? "warning" : "good"}"
    :space-evenly false
    :spacing 4
    (image
      :icon {battery-status == "Full" ? "battery-full-charged-symbolic" :
        "battery-${battery-capacity <= 10 ? "caution" :
                   battery-capacity <= 30 ? "low" :
                   battery-capacity <= 70 ? "good" : "full"}${battery-status == "Charging" ? "-charging" : ""}-symbolic"}
      :icon-size "button")
    (label
      :text "${battery-capacity}%")))

(defwidget clock []
  (box
    :space-evenly false
    (label
      :class "clock-date"
      :halign "end"
      :justify "right"
      :text "${formattime(EWW_TIME, "%a %b %-d", time-zone)}")
    (label
      :class "clock-time"
      :halign "end"
      :justify "right"
      :text "${formattime(EWW_TIME, "%-I:%M:%S %p", time-zone)}")
    (label
      :class "clock-time"
      :halign "end"
      :justify "right"
      :text "(${formattime(EWW_TIME, "%H:%M:%S", "UTC")} UTC)")))
