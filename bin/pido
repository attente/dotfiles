#!/bin/sh
# Run pi from the device memory directory.
#
# Usage:
#   pido [-p|--print] [-c|--continue] [-s|--system-prompt <text|path>]
#        [--] [prompt...]
#
# All arguments after the optional flags are forwarded to pi as the prompt.
# A system prompt given with -s is appended to pi's default system prompt.
# If no prompt is given, pi starts interactively in the memory directory.

set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
memory_dir=$script_dir/../pi/memory
print_mode=false
continue_mode=false
system_prompt=""

while [ "$#" -gt 0 ]; do
  case $1 in
    -p|--print)
      print_mode=true
      shift
      ;;
    -c|--continue)
      continue_mode=true
      shift
      ;;
    -s|--system-prompt)
      if [ "$#" -lt 2 ]; then
        printf 'pido: %s needs text or a file path\n' "$1" >&2
        exit 2
      fi
      system_prompt=$2
      shift 2
      ;;
    -h|--help)
      printf '%s\n' \
        'Usage: pido [-p|--print] [-c|--continue]' \
        '            [-s|--system-prompt <text|path>] [--] [prompt...]'
      exit 0
      ;;
    --)
      shift
      break
      ;;
    *)
      break
      ;;
  esac
done

if [ ! -d "$memory_dir" ]; then
  printf 'pido: memory directory not found: %s\n' "$memory_dir" >&2
  exit 1
fi

cd "$memory_dir"

export HERDR_ENV=1

if [ -n "$system_prompt" ]; then
  set -- --append-system-prompt "$system_prompt" -- "$@"
else
  set -- -- "$@"
fi

if [ "$print_mode" = true ] && [ "$continue_mode" = true ]; then
  exec pi --print --continue "$@"
elif [ "$print_mode" = true ]; then
  exec pi --print "$@"
elif [ "$continue_mode" = true ]; then
  exec pi --continue "$@"
else
  exec pi "$@"
fi
