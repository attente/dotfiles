# Copy to /etc/pido-telegram.env and restrict permissions:
#   sudo install -m 600 -o root -g root oxygen/pido-telegram.env.example /etc/pido-telegram.env
# Then edit the copied file and start the service:
#   sudo systemctl start pido-telegram

TELEGRAM_BOT_TOKEN=replace-with-your-bot-token
TELEGRAM_ALLOWED_USER_ID=replace-with-your-numeric-telegram-user-id
